---
import Palette from "../icons/Palette.astro";
---

<div class="absolute right-4 top-4 z-10 sm:right-6 sm:top-10">
  <button
    id="btn-temas"
    type="button"
    aria-label="Seleccionar tema"
    class="flex h-9 w-9 items-center justify-center rounded-lg text-slate transition hover:bg-paper-alt"
  >
    <Palette size={18} />
  </button>
  <div id="popover-temas" class="hidden absolute right-0 top-10 z-20 w-46 rounded-xl border border-mist bg-surface p-1.5 shadow-lg"></div>
</div>
