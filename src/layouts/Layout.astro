---
import "../styles/global.css";

interface Props {
  titulo?: string;
}

const { titulo = "Calendario de medicamentos" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..700,0..100&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var tema;
        try { tema = localStorage.getItem("med-calendario:tema"); } catch (e) {}
        if (tema === "dark") {
          tema = "midnight";
          try { localStorage.setItem("med-calendario:tema", "midnight"); } catch (e) {}
        }
        if (!tema) {
          tema = window.matchMedia("(prefers-color-scheme: dark)").matches ? "midnight" : "light";
        }
        if (tema !== "light") {
          document.documentElement.setAttribute("data-theme", tema);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen font-body text-ink antialiased">
    <slot />
  </body>
</html>
