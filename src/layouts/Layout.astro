---
import "../styles/global.css";

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = "Calendario de medicamentos y suplementos",
  descripcion = "Organizá tus medicamentos y suplementos con un calendario visual. Registrá dosis, horarios y mantené el control de tu salud día a día.",
} = Astro.props;

const urlBase = "https://med-calendar.netlify.app";
const urlCompleta = `${urlBase}/`;
const imagenOG = `${urlBase}/med-calendar-og.webp`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO básico -->
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={urlCompleta} />
    <meta name="author" content="Leo Ss" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" itemprop="image" content={imagenOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={urlCompleta} />
    <meta property="og:site_name" content="Med Calendar" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="med-calendar.netlify.app" />
    <meta name="twitter:url" content={urlCompleta} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOG} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..700,0..100&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var tema;
        try { tema = localStorage.getItem("med-calendario:tema"); } catch (e) {}
        if (tema === "dark") {
          tema = "midnight";
          try { localStorage.setItem("med-calendario:tema", "midnight"); } catch (e) {}
        }
        if (!tema) {
          tema = window.matchMedia("(prefers-color-scheme: dark)").matches ? "midnight" : "light";
        }
        if (tema !== "light") {
          document.documentElement.setAttribute("data-theme", tema);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen font-body text-ink antialiased">
    <link itemprop="thumbnailUrl" href={imagenOG} />
    <span itemprop="image" itemscope itemtype="http://schema.org/ImageObject">
      <link itemprop="url" href={imagenOG} />
    </span>
    <slot />
  </body>
</html>
