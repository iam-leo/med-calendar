---
import Layout from "../layouts/Layout.astro";
import Sun from "../icons/Sun.astro";
import Moon from "../icons/Moon.astro";
---

<Layout titulo="Calendario de medicamentos y suplementos">
  <div class="relative mx-auto flex min-h-screen max-w-5xl flex-col gap-6 px-4 py-6 sm:px-6 sm:py-10">
    <!-- Theme toggle -->
    <button
      id="btn-toggle-tema"
      type="button"
      aria-label="Cambiar tema"
      class="absolute right-4 top-4 z-10 flex h-9 w-9 items-center justify-center rounded-lg text-slate transition hover:bg-paper-alt sm:right-6 sm:top-10"
    >
      <Sun class="theme-sun" size={20} />
      <Moon class="theme-moon" size={20} />
    </button>

    <!-- Encabezado -->
    <header class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-moss text-lg text-paper">
          💊
        </div>
        <div>
          <h1 class="font-display text-xl font-semibold leading-tight text-ink sm:text-2xl">
            Calendario de tomas
          </h1>
          <p class="text-sm text-slate">Registrá tus medicamentos y suplementos, día a día.</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 rounded-2xl border border-mist bg-surface p-2 sm:justify-between sm:gap-3 sm:p-3">
        <div class="flex items-center gap-1.5">
          <button
            id="btn-mes-anterior"
            type="button"
            aria-label="Mes anterior"
            class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-paper-alt text-ink transition hover:bg-mist sm:h-10 sm:w-10"
          >
            <span aria-hidden="true" class="text-base sm:text-lg">‹</span>
          </button>
          <h2 id="mes-titulo" class="min-w-[8rem] text-center font-display text-sm font-semibold sm:min-w-[10rem] sm:text-lg">
            &nbsp;
          </h2>
          <button
            id="btn-mes-siguiente"
            type="button"
            aria-label="Mes siguiente"
            class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-paper-alt text-ink transition hover:bg-mist sm:h-10 sm:w-10"
          >
            <span aria-hidden="true" class="text-base sm:text-lg">›</span>
          </button>
          <button
            id="btn-hoy"
            type="button"
            class="ml-1.5 rounded-lg border border-mist px-2.5 py-1 text-xs font-medium text-slate transition hover:border-moss hover:text-moss sm:ml-2 sm:px-3 sm:py-1.5"
          >
            Hoy
          </button>
        </div>

        <div class="flex items-center gap-2">
          <button
            id="btn-agregar-item"
            type="button"
            class="rounded-lg bg-moss px-3 py-1.5 text-xs font-semibold text-paper transition hover:bg-moss-dark sm:px-4 sm:py-2 sm:text-sm"
          >
            + Agregar ítem
          </button>
        </div>
      </div>

      <!-- Lista de ítems registrados -->
      <div>
        <p class="mb-3 text-xs font-medium uppercase tracking-wider text-slate">Tu botiquín</p>
        <div id="estado-vacio-items" class="empty-state">
          <div class="empty-state__grid">
            <span>💊</span><span>💉</span><span>🌿</span>
            <span>🧴</span><span>🩹</span><span>🫙</span>
            <span>💧</span><span>🌸</span><span>🍃</span>
          </div>
          <p class="empty-state__title">Todavía no tenés medicamentos registrados</p>
          <p class="empty-state__desc">Agregá tu primer medicamento o suplemento para empezar a registrar tus tomas diarias.</p>
        </div>
        <div id="lista-items" class="flex flex-wrap gap-2"></div>
      </div>
    </header>

    <!-- Calendario -->
    <main>
      <div id="encabezado-dias" class="grid grid-cols-7 gap-1 sm:gap-1.5"></div>
      <div id="grilla-calendario" class="mt-1 grid grid-cols-7 gap-1 sm:gap-1.5"></div>
    </main>

    <!-- Estadísticas -->
    <section id="seccion-estadisticas" class="hidden mt-5 rounded-2xl border border-mist bg-surface p-4 sm:p-5">
      <h2 class="mb-3 font-display text-base font-semibold text-ink">Estadísticas</h2>
      <div id="grilla-estadisticas" class="grid grid-cols-2 gap-3 sm:grid-cols-4"></div>
    </section>

    <footer class="pb-6 text-center text-xs text-slate">
      Tus datos se guardan únicamente en este navegador (localStorage).
    </footer>
  </div>

  <!-- Modal: agregar / editar ítem -->
  <div id="modal-item" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-item-titulo">
    <div class="modal-overlay__content w-full max-w-md p-5 sm:p-6">
      <div class="mb-4 flex items-center justify-between">
        <h3 id="modal-item-titulo" class="font-display text-lg font-semibold">Agregar ítem</h3>
        <button
          id="btn-cerrar-modal-item"
          type="button"
          aria-label="Cerrar"
          class="flex h-8 w-8 items-center justify-center rounded-lg text-slate hover:bg-paper-alt"
        >
          <span aria-hidden="true">✕</span>
        </button>
      </div>

      <form id="form-item" class="flex flex-col gap-4">
        <div>
          <label for="item-nombre" class="mb-1.5 block text-sm font-medium text-ink">Nombre</label>
          <input
            id="item-nombre"
            type="text"
            required
            placeholder='Ej: "Ibuprofeno 400mg"'
            class="w-full rounded-lg border border-mist px-3 py-2 text-sm outline-none focus:border-moss"
          />
        </div>

        <div>
          <p class="mb-1.5 block text-sm font-medium text-ink">Categoría</p>
          <div id="presets-categoria" class="flex flex-wrap gap-2"></div>
        </div>

        <div id="seccion-emoji" class="hidden">
          <p class="mb-1.5 block text-sm font-medium text-ink">Elegí un emoji</p>
          <div id="picker-emoji" class="flex flex-wrap gap-1.5"></div>
        </div>

        <div>
          <p class="mb-1.5 block text-sm font-medium text-ink">Color de la etiqueta</p>
          <div class="flex flex-wrap items-center gap-2">
            <div id="picker-color" class="flex flex-wrap gap-2"></div>
            <input
              id="color-personalizado"
              type="color"
              value="#2F5D53"
              aria-label="Color personalizado"
              class="h-8 w-8 cursor-pointer rounded-full border-0 bg-transparent p-0"
            />
          </div>
        </div>

        <div>
          <p class="mb-1.5 block text-sm font-medium text-ink">Vista previa</p>
          <span id="vista-previa-tag" class="tag-pill" style="font-size:0.9rem;padding:0.4rem 0.9rem;"></span>
        </div>

        <div class="mt-2 flex items-center justify-between gap-2">
          <button
            id="btn-eliminar-item"
            type="button"
            class="hidden rounded-lg border border-clay px-3 py-2 text-sm font-medium text-clay hover:bg-clay/10"
          >
            Eliminar
          </button>
          <div class="ml-auto flex gap-2">
            <button
              id="btn-cancelar-item"
              type="button"
              class="rounded-lg border border-mist px-4 py-2 text-sm font-medium text-slate hover:bg-paper-alt"
            >
              Cancelar
            </button>
            <button type="submit" class="rounded-lg bg-moss px-4 py-2 text-sm font-semibold text-paper hover:bg-moss-dark">
              Guardar
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: tomas del día -->
  <div id="modal-dia" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="dia-modal-titulo">
    <div class="modal-overlay__content w-full max-w-sm p-5 sm:p-6">
      <div class="mb-3 flex items-center justify-between gap-3">
        <h3 id="dia-modal-titulo" class="font-display text-base font-semibold capitalize">&nbsp;</h3>
        <button
          id="btn-cerrar-modal-dia"
          type="button"
          aria-label="Cerrar"
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate hover:bg-paper-alt"
        >
          <span aria-hidden="true">✕</span>
        </button>
      </div>

      <div id="estado-vacio-dia" class="hidden empty-state empty-state--compact">
        <span class="text-2xl">📋</span>
        <div>
          <p class="text-sm font-medium text-ink">Tu botiquín está vacío</p>
          <p class="text-xs text-slate">Agregá un medicamento o suplemento desde el calendario para empezar a registrar.</p>
        </div>
      </div>
      <div id="lista-tomas-dia" class="flex flex-col"></div>
    </div>
  </div>

  <script>
    import { iniciarApp } from "../lib/app";
    iniciarApp();
  </script>
</Layout>
