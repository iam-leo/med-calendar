---
import Layout from "../layouts/Layout.astro";
import AppHeader from "../components/AppHeader.astro";
import ThemeSelector from "../components/ThemeSelector.astro";
import Footer from "../components/Footer.astro";
import DataNotice from "../components/DataNotice.astro";
import MonthNavigator from "../components/MonthNavigator.astro";
import Botiquin from "../components/Botiquin.astro";
import CalendarDesktop from "../components/CalendarDesktop.astro";
import Stats from "../components/Stats.astro";
import ItemModal from "../components/ItemModal.astro";
import DayModal from "../components/DayModal.astro";
import MobileView from "../components/MobileView.astro";
---

<Layout titulo="Calendario de medicamentos y suplementos">
  <div class="relative mx-auto flex min-h-screen max-w-5xl flex-col gap-6 px-4 py-6 sm:px-6 sm:py-10">
    <!-- Theme selector -->
    <ThemeSelector />

    <!-- Encabezado -->
    <header class="flex flex-col gap-4">
      <AppHeader />

      <MonthNavigator />

      <Botiquin />
    </header>

    <!-- Calendario (escritorio) -->
    <CalendarDesktop />

    <!-- Vista móvil -->
    <MobileView />

    <!-- Estadísticas -->
    <Stats />

    <DataNotice />
  </div>

  <!-- Modal: agregar / editar ítem -->
  <ItemModal />

  <!-- Modal: tomas del día -->
  <DayModal />

  <Footer />

  <script>
    import { iniciarApp } from "../lib/app";
    iniciarApp();
  </script>
</Layout>
