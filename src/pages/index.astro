---
import Layout from "../layouts/Layout.astro";
import AppHeader from "../components/AppHeader.astro";
import ThemeSelector from "../components/ThemeSelector.astro";
import ChevronLeft from "../icons/ChevronLeft.astro";
import ChevronRight from "../icons/ChevronRight.astro";
import X from "../icons/X.astro";
import Plus from "../icons/Plus.astro";
import Trash2 from "../icons/Trash2.astro";
import Check from "../icons/Check.astro";
import Cross from "../icons/Cross.astro";
import Github from "../icons/Github.astro";
---

<Layout titulo="Calendario de medicamentos y suplementos">
  <div class="relative mx-auto flex min-h-screen max-w-5xl flex-col gap-6 px-4 py-6 sm:px-6 sm:py-10">
    <!-- Theme selector -->
    <ThemeSelector />

    <!-- Encabezado -->
    <header class="flex flex-col gap-4">
      <AppHeader />

      <div class="flex flex-wrap items-center gap-2 rounded-2xl border border-mist bg-surface p-2 sm:justify-between sm:gap-3 sm:p-3">
        <div class="flex items-center gap-1.5">
          <button
            id="btn-mes-anterior"
            type="button"
            aria-label="Mes anterior"
            class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-paper-alt text-ink transition hover:bg-mist sm:h-10 sm:w-10"
          >
            <ChevronLeft size={20} />
          </button>
          <h2 id="mes-titulo" class="min-w-[8rem] text-center font-display text-sm font-semibold sm:min-w-[10rem] sm:text-lg">
            &nbsp;
          </h2>
          <button
            id="btn-mes-siguiente"
            type="button"
            aria-label="Mes siguiente"
            class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-paper-alt text-ink transition hover:bg-mist sm:h-10 sm:w-10"
          >
            <ChevronRight size={20} />
          </button>
          <button
            id="btn-hoy"
            type="button"
            class="ml-1.5 rounded-lg border border-mist px-2.5 py-1 text-xs font-medium text-slate transition hover:border-moss hover:text-moss sm:ml-2 sm:px-3 sm:py-1.5"
          >
            Hoy
          </button>
        </div>

        <div class="flex items-center gap-2">
          <button
            id="btn-agregar-item"
            type="button"
            class="flex items-center gap-1.5 rounded-lg bg-moss px-3 py-1.5 text-xs font-semibold text-paper transition hover:bg-moss-dark sm:px-4 sm:py-2 sm:text-sm"
          >
            <Plus size={16} /> Agregar ítem
          </button>
        </div>
      </div>

      <!-- Lista de ítems registrados -->
      <div>
        <p class="mb-3 flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider text-slate"><Cross size={12} /> Tu botiquín</p>
        <div id="estado-vacio-items" class="empty-state">
          <div class="empty-state__grid">
            <span>💊</span><span>💉</span><span>🌿</span>
            <span>🧴</span><span>🩹</span><span>🫙</span>
            <span>💧</span><span>🌸</span><span>🍃</span>
          </div>
          <p class="empty-state__title">Todavía no tenés medicamentos registrados</p>
          <p class="empty-state__desc">Agregá tu primer medicamento o suplemento para empezar a registrar tus tomas diarias.</p>
        </div>
        <div id="lista-items" class="flex flex-wrap gap-2"></div>
      </div>
    </header>

    <!-- Calendario (escritorio) -->
    <main class="max-sm:hidden">
      <div id="encabezado-dias" class="grid grid-cols-7 gap-1 sm:gap-1.5"></div>
      <div id="grilla-calendario" class="mt-1 grid grid-cols-7 gap-1 sm:gap-1.5"></div>
    </main>

    <!-- Vista móvil -->
    <div id="vista-mobile" class="sm:hidden">
      <!-- Mini calendario compacto -->
      <div class="rounded-2xl border border-mist bg-surface p-2">
        <div id="encabezado-dias-mobile" class="mb-1 grid grid-cols-7 gap-0.5"></div>
        <div id="mini-calendario" class="grid grid-cols-7 gap-0.5"></div>
      </div>

      <!-- Estado: seleccioná un día -->
      <div id="estado-selecciona-dia" class="flex flex-col items-center gap-2 py-8 text-center">
        <span class="text-3xl">👆</span>
        <p class="text-sm font-medium text-ink">Seleccioná un día para ver tus tomas</p>
        <p class="text-xs text-slate">Tocá cualquier día del calendario para registrar o revisar tus dosis.</p>
      </div>

      <!-- Detalle del día (inline) -->
      <div id="detalle-dia-mobile" class="hidden mt-3 rounded-2xl border border-mist bg-surface p-3">
        <div class="mb-2 flex items-center justify-between">
          <button
            id="btn-dia-anterior" type="button" aria-label="Día anterior"
            class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-paper-alt text-ink transition hover:bg-mist"
          ><ChevronLeft size={16} /></button>
          <h3 id="dia-mobile-titulo" class="font-display text-sm font-semibold capitalize text-ink">&nbsp;</h3>
          <button
            id="btn-dia-siguiente" type="button" aria-label="Día siguiente"
            class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-paper-alt text-ink transition hover:bg-mist"
          ><ChevronRight size={16} /></button>
        </div>
        <div id="lista-tomas-mobile" class="flex flex-col"></div>
        <div id="estado-vacio-dia-mobile" class="hidden flex-col items-center gap-2 py-4 text-center">
          <span class="text-2xl">📋</span>
          <p class="text-sm font-medium text-ink">Tu botiquín está vacío</p>
          <p class="text-xs text-slate">Agregá un medicamento o suplemento para empezar a registrar tus tomas.</p>
          <button
            id="btn-agregar-desde-vacio-mobile" type="button"
            class="flex items-center gap-1.5 rounded-lg bg-moss px-3.5 py-1.5 text-xs font-semibold text-paper transition hover:bg-moss-dark"
          ><Plus size={14} /> Agregar medicamento</button>
        </div>
      </div>
    </div>

    <!-- Estadísticas -->
    <section id="seccion-estadisticas" class="hidden mt-5 rounded-2xl border border-mist bg-surface p-4 sm:p-5 max-sm:hidden">
      <h2 class="mb-3 font-display text-base font-semibold text-ink">Estadísticas</h2>
      <div id="grilla-estadisticas" class="grid grid-cols-2 gap-3 sm:grid-cols-4"></div>
    </section>

    <footer class="pb-6 text-center text-xs text-slate">
      Tus datos se guardan únicamente en este navegador (localStorage).
    </footer>
  </div>

  <!-- Modal: agregar / editar ítem -->
  <div id="modal-item" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-item-titulo">
    <div class="modal-overlay__content w-full max-w-md p-5 sm:p-6">
      <div class="mb-4 flex items-center justify-between">
        <h3 id="modal-item-titulo" class="font-display text-lg font-semibold">Agregar ítem</h3>
        <button
          id="btn-cerrar-modal-item"
          type="button"
          aria-label="Cerrar"
          class="flex h-8 w-8 items-center justify-center rounded-lg text-slate hover:bg-paper-alt"
        >
          <X size={16} />
        </button>
      </div>

      <form id="form-item" class="flex flex-col gap-4">
        <div>
          <label for="item-nombre" class="mb-1.5 block text-sm font-medium text-ink">Nombre</label>
          <input
            id="item-nombre"
            type="text"
            required
            placeholder='Ej: "Ibuprofeno 400mg"'
            class="w-full rounded-lg border border-mist px-3 py-2 text-sm outline-none focus:border-moss"
          />
        </div>

        <div>
          <p class="mb-1.5 block text-sm font-medium text-ink">Categoría</p>
          <div id="presets-categoria" class="flex flex-wrap gap-2"></div>
        </div>

        <div id="seccion-emoji" class="hidden">
          <p class="mb-1.5 block text-sm font-medium text-ink">Elegí un emoji</p>
          <div id="picker-emoji" class="flex flex-wrap gap-1.5"></div>
        </div>

        <div>
          <p class="mb-1.5 block text-sm font-medium text-ink">Color de la etiqueta</p>
          <div class="flex flex-wrap items-center gap-2">
            <div id="picker-color" class="flex flex-wrap gap-2"></div>
            <input
              id="color-personalizado"
              type="color"
              value="#2F5D53"
              aria-label="Color personalizado"
              class="h-8 w-8 cursor-pointer rounded-full border-0 bg-transparent p-0"
            />
          </div>
        </div>

        <div>
          <p class="mb-1.5 block text-sm font-medium text-ink">Vista previa</p>
          <span id="vista-previa-tag" class="tag-pill" style="font-size:0.9rem;padding:0.4rem 0.9rem;"></span>
        </div>

        <div class="mt-2 flex items-center justify-between gap-2">
          <button
            id="btn-eliminar-item"
            type="button"
            class="hidden flex items-center gap-1.5 rounded-lg border border-clay px-3 py-2 text-sm font-medium text-clay hover:bg-clay/10"
          >
            <Trash2 size={16} /> Eliminar
          </button>
          <div class="ml-auto flex gap-2">
            <button
              id="btn-cancelar-item"
              type="button"
              class="rounded-lg border border-mist px-4 py-2 text-sm font-medium text-slate hover:bg-paper-alt"
            >
              Cancelar
            </button>
            <button type="submit" class="flex items-center gap-1.5 rounded-lg bg-moss px-4 py-2 text-sm font-semibold text-paper hover:bg-moss-dark">
              <Check size={16} /> Guardar
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: tomas del día -->
  <div id="modal-dia" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="dia-modal-titulo">
    <div class="modal-overlay__content w-full max-w-sm p-5 sm:p-6">
      <div class="mb-3 flex items-center justify-between gap-3">
        <h3 id="dia-modal-titulo" class="font-display text-base font-semibold capitalize">&nbsp;</h3>
        <button
          id="btn-cerrar-modal-dia"
          type="button"
          aria-label="Cerrar"
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate hover:bg-paper-alt"
        >
          <X size={16} />
        </button>
      </div>

      <div id="estado-vacio-dia" class="hidden empty-state empty-state--compact">
        <span class="text-2xl">📋</span>
        <div class="flex flex-col gap-2">
          <p class="text-sm font-medium text-ink">Tu botiquín está vacío</p>
          <p class="text-xs text-slate">Agregá un medicamento o suplemento para empezar a registrar tus tomas.</p>
          <button
            id="btn-agregar-desde-vacio"
            type="button"
            class="mt-1 self-start flex items-center gap-1.5 rounded-lg bg-moss px-3.5 py-1.5 text-xs font-semibold text-paper transition hover:bg-moss-dark"
          >
            <Plus size={14} /> Agregar medicamento
          </button>
        </div>
      </div>
      <div id="lista-tomas-dia" class="flex flex-col"></div>
    </div>
  </div>

  <footer class="app-footer">
    <span id="footer-frase" class="app-footer__frase"></span>
    <a href="https://github.com/iam-leo" target="_blank" rel="noopener noreferrer" class="app-footer__github">
      <Github size={14} /> By Leo Ss
    </a>
  </footer>

  <script>
    import { iniciarApp } from "../lib/app";
    iniciarApp();

    const frases = [
      "✨ Cada día es una nueva oportunidad para cuidarte",
      "💪 La constancia es la clave del cambio",
      "🌿 Pequeños pasos llevan a grandes resultados",
      "💛 Tu salud es tu mayor tesoro",
      "🌻 Hoy es un buen día para empezar",
      "🌱 Cada vez que cuidas de ti, florecés",
      "⭐ La disciplina supera al talento",
      "🦋 Transformate con paciencia",
      "🔥 Seguí adelante, ya recorriste un largo camino",
      "☀️ Lo mejor está por venir",
      "🍀 La gratitud transforma lo que tenemos en suficiente",
      "💫 Vos podés con todo lo que te proponés",
    ];
    const fraseEl = document.getElementById("footer-frase");
    if (fraseEl) {
      const ahora = new Date();
      const idx = Math.floor(Math.random() * frases.length);
      fraseEl.textContent = `${ahora.getFullYear()} | ${frases[idx]}`;
    }
  </script>
</Layout>
